# ── Neon PostgreSQL ──────────────────────────────────────────────────
# Dashboard → Connection Details → Pooled connection string
DATABASE_URL=postgres://user:password@ep-xxx.sa-east-1.aws.neon.tech/neondb?sslmode=require

# ── Token de sesión ──────────────────────────────────────────────────
# Generalo con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
DMTH_TOKEN_SECRET=reemplaza_esto_por_un_string_largo_aleatorio_de_al_menos_48_chars

# ── Copia este archivo como .env.local para desarrollo local ─────────
# En Vercel: Project → Settings → Environment Variables
